# Image production tunggal: frontend di-build lalu disajikan oleh backend Rust
# (lihat apps/backend/src/routes/spa.rs -- termasuk inject OG tags per wedding).
#
# Build dari ROOT repo (context = ..):
#   docker build -f infra/Dockerfile.prod -t undangan-app .
# atau lewat infra/docker-compose.prod.yml (sudah diarahkan ke file ini).

# ---------- Stage 1: build frontend (vite build) ----------
FROM node:22-alpine AS frontend-builder
WORKDIR /app
COPY apps/frontend/package.json apps/frontend/package-lock.json ./
RUN npm ci
COPY apps/frontend/ ./
RUN npm run build

# ---------- Stage 2: build backend (cargo release) ----------
# -bookworm eksplisit: harus SAMA dengan basis Debian stage runtime di bawah,
# kalau beda versi glibc binary-nya tidak bisa jalan ("GLIBC_x.y not found").
FROM rust:1-slim-bookworm AS backend-builder
RUN apt-get update \
    && apt-get install -y --no-install-recommends pkg-config libssl-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app

# Layer cache dependencies: build dulu dengan src dummy supaya perubahan kode
# aplikasi tidak memicu compile ulang seluruh pohon dependency.
COPY apps/backend/Cargo.toml apps/backend/Cargo.lock ./
RUN mkdir src && echo "fn main() {}" > src/main.rs \
    && cargo build --release \
    && rm -rf src

# migrations ikut ter-embed ke binary oleh sqlx::migrate!() saat compile.
COPY apps/backend/ ./
RUN touch src/main.rs && cargo build --release

# ---------- Stage 3: runtime ----------
FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates libssl3 curl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app

COPY --from=backend-builder /app/target/release/undangan-backend /usr/local/bin/undangan-backend
COPY --from=frontend-builder /app/dist /app/dist

ENV FRONTEND_DIST_DIR=/app/dist
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD curl -fsS http://localhost:8080/api/music > /dev/null || exit 1

CMD ["undangan-backend"]
