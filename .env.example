# Satu-satunya sumber konfigurasi untuk seluruh stack (dipakai oleh semua service
# di infra/docker-compose.yml). Copy jadi ".env" di root yang sama, lalu jalankan
# lewat `make up` (baca Makefile) supaya Compose otomatis membaca file ini.

# PostgreSQL
POSTGRES_USER=undangan
POSTGRES_PASSWORD=undangan
POSTGRES_DB=undangan
POSTGRES_PORT=5432

# MinIO
MINIO_ROOT_USER=undangan_admin
MINIO_ROOT_PASSWORD=undangan_secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=undangan-assets

# Backend (Rust/Axum)
BACKEND_PORT=8080

# Admin Dashboard (kredensial konstan, WAJIB diganti sebelum production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-password-ini

# Frontend (React/Vite)
FRONTEND_PORT=5173
